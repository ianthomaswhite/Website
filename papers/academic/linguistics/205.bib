@incollection{Ramon2014,
abstract = {The Greek middle-passive aorist in-j-is a marker of the inflectional categories aspect and voice, goes actually back to the inherited stative morpheme-j-(IE *-eh 1-), which originally expressed state. It has been integrated in the inflectional system of Greek verb as the result of a grammaticalisation process, starting from, at least, two types of verbal lexemes, from which it spread secondarily to others. On the one hand, telic-transformative lexemes, where it redundantly stresses that the [reaching of a state] by the subject has been fulfilled. On the other hand, stative lexemes with no inherited aorist, where the (mor-phologically marked)-j-aorist completes the paradigm and expresses the entry into the state expressed by the lexeme.},
address = {Louvain-La-Neuve},
author = {Ram{\'{o}}n, Jos{\'{e}} Luis Garc{\'{i}}a},
booktitle = {{Proceedings of the 8th International Meeting on Greek Linguistics}},
editor = {Bartolotta, Annamaria},
file = {:Users/mollychatcat/Library/Application Support/Mendeley Desktop/Downloaded/Luis, Ram{\'{o}}n - Unknown - FROM AKTIONSART TO ASPECT AND VOICE ON THE MORPHOSYNTAX OF THE GREEK AORISTS WITH-j-AND-qj-.pdf:pdf},
publisher = {Peeters},
title = {{From aktionsart to aspect and voice: on the morphosyntax of the Greek aorists with -$\eta$- and -$\theta$$\eta$-}},
year = {2014}
}
@article{Tronci2018,
abstract = {This paper deals with the aorist voice system in NT Greek and focuses on middle-passive markers, namely middle inflection, e.g. in the middle sigmatic aorist, and affixes -$\eta$-/-$\theta$$\eta$-, in the so-called passive aorist. The research is corpus-based and investigates the occurrences of ca. 1800 verbal items. According to the grammarians, in the NT both middle and passive aorists spread. The present study confirms this observation by providing a comprehensive account of the distribution of these forms, but also shows how they have functionally reorganised. Passive aorists spread at the expense of middle aorists in all kinds of intransitive constructions, namely passive, unaccusative, and reflexive, whereas middle aorists are either found in transitive middles, e.g. possessive, benefactive etc., or occur as deponent verbs in both transitive and intransitive clauses. The parameter transitive vs intransitive appears to be relevant for this functional reorganisation.},
author = {Tronci, Liana},
doi = {10.1163/15699846-01802005},
file = {:Users/mollychatcat/Library/Application Support/Mendeley Desktop/Downloaded/Tronci - 2018 - Aorist voice patterns in the diachrony of Greek The New Testament as a sample of Koine.pdf:pdf},
issn = {15699846},
journal = {Journal of Greek Linguistics},
keywords = {Ancient Greek,New Testament,aorist,deponent,middle,passive,voice},
number = {2},
pages = {241--280},
publisher = {Brill Academic Publishers},
title = {{Aorist voice patterns in the diachrony of Greek: The New Testament as a sample of Koine}},
volume = {18},
year = {2018}
}
@article{Alexiadou2012,
abstract = {The paper offers a theoretical characterization of the middle Voice as distinct from the passive Voice, and addresses the cross-linguistic morphological variation in realizing these two non-active Voices in different classes of languages, represented by Hebrew, Greek and English. The two non-active Voices are the morphological realization of two distinct syntactic Voice heads generating middle and passive clauses respectively. The former are cross-linguistically interpreted as (i) anticausative, (ii) reflexive (and reciprocal), (iii) dispositional middle, and (iv) medio-passive, which is distinct from passive. This variation in the interpretation of the middle Voice reflects different properties of the root rather than the application of four different lexical rules postulated by lexicalist theories. {\textcopyright} 2011 Cambridge University Press.},
author = {Alexiadou, Artemis and Doron, Edit},
doi = {10.1017/S0022226711000338},
file = {:Users/mollychatcat/Library/Application Support/Mendeley Desktop/Downloaded/Alexiadou, Doron - 2012 - The syntactic construction of two non-active Voices Passive and middle.pdf:pdf},
issn = {00222267},
journal = {Journal of Linguistics},
month = {mar},
number = {1},
pages = {1--34},
title = {{The syntactic construction of two non-active Voices: Passive and middle}},
volume = {48},
year = {2012}
}
@article{Merchant2015,
abstract = {Greek voice and aspect jointly condition verbal stem allomorphy, including suppletion. Negation and tense in English do likewise. These cases show that stem allomorphy cannot be restricted to cases where the conditioning element is structurally adjacent to the element that displays allomorphic variation. But neither is contextual allomorphy entirely free from locality constraints: allomorphy can be conditioned only by a span, a contiguous set of heads in an extended projection.},
author = {Merchant, Jason},
doi = {10.1162/ling_a_00182},
file = {:Users/mollychatcat/Library/Application Support/Mendeley Desktop/Downloaded/Merchant - 2015 - How much context is enough Two cases of span-conditioned stem allomorphy.pdf:pdf},
issn = {15309150},
journal = {Linguistic Inquiry},
keywords = {Allomorphy,English,Greek,Span},
month = {apr},
number = {2},
pages = {273--303},
publisher = {MIT Press Journals},
title = {{How much context is enough? Two cases of span-conditioned stem allomorphy}},
volume = {46},
year = {2015}
}
